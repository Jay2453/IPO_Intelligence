# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Default local SQLite fallback for instant zero-dependency execution:
DATABASE_URL=sqlite:///./ipo_intelligence.db
# PostgreSQL target (when running via Docker Compose or external PG):
# DATABASE_URL=postgresql+psycopg://ipo_user:ipo_password@localhost:5432/ipo_intelligence

# Development-Only Seed Controls
# Strictly disabled in production. Set to true to allow /api/v1/seed/demo
ENABLE_DEV_SEED=true

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Official Source Integration (NSE)
NSE_BASE_URL=https://www.nseindia.com
INGESTION_SYNC_INTERVAL_MINUTES=15
ENABLE_SCHEDULED_INGESTION=false
# Optional token to protect manual sync endpoint in production
INGESTION_API_KEY=
# Opt-in live smoke test against official NSE endpoints (set true to run live smoke tests)
RUN_LIVE_TESTS=false
